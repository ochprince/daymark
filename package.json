{
  "name": "daymark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && CAPACITOR_BUILD=1 vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -b",
    "cap:sync": "npm run build:native && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource-variable/inter": "^5.1.1",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
